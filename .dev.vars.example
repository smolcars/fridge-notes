# Copy to .dev.vars for `bun run dev` / `celld dev`. These values match the smoke test defaults.
# Never use them in production: generate real tokens with `openssl rand -hex 32`.

# This server's public URL. OAuth clients and tokens are bound to it.
PUBLIC_URL=http://127.0.0.1:8787

# Typed on the approval page when an app connects over OAuth. 16+ characters.
OWNER_PASSWORD=dev-owner-password-0000

# Optional fixed tokens for clients that can't do OAuth. One `name:token` pair per agent.
# The name becomes `from` on that agent's messages.
AUTH_TOKENS=grok:dev-grok-token-0000,agent:dev-agent-token-0000

# A doorbell from settings, for setups without the approval page (celld today): notes sent to
# WEBHOOK_AGENT call WEBHOOK_URL with WEBHOOK_TOKEN as the bearer key. With OAuth, set doorbells
# on the approval page instead and leave these out.
WEBHOOK_AGENT=grok
WEBHOOK_URL=http://127.0.0.1:8788/webhook
WEBHOOK_TOKEN=dev-webhook-token
