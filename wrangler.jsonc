{
  // Keep this file within the subset celld accepts (no `routes`, `observability`, etc.)
  // so the same config deploys to Cloudflare (`wrangler deploy`) and celld (`celld deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fridge-notes",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Blocks OAuth client-metadata fetches from reaching private addresses (SSRF). The OAuth library
  // only accepts metadata-URL clients where the runtime enforces it.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "Board" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  // OAuth clients, grants and tokens. The id is this deployment's namespace, which wrangler created
  // and wrote here. Deploying your own copy? Delete the id and wrangler creates yours. celld takes
  // any string as the id.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "5239f2a8c2ae4e03a2478f3ae394b305" }],
}
